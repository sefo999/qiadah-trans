---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Icon from '../../../components/Icon.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import SectorsGrid from '../../../components/SectorsGrid.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { t } from '../../../i18n/ui';
import { locales, path, type Lang } from '../../../i18n/utils';
import { sectors } from '../../../data/sectors';
import { serviceBySlug } from '../../../data/services';
import { images } from '../../../data/images';

export function getStaticPaths() {
  return locales.flatMap((lang) => sectors.map((s) => ({ params: { lang, slug: s.slug }, props: { sector: s } })));
}
const lang = Astro.params.lang as Lang;
const { sector } = Astro.props;
const tr = t(lang);
const related = sector.services.map(serviceBySlug).filter(Boolean);
---

<Base lang={lang} title={sector.title[lang]} description={sector.short[lang]} slug={`sectors/${sector.slug}`}>
  <PageHero
    lang={lang}
    eyebrow={tr('sectors.eyebrow')}
    title={sector.title[lang]}
    text={sector.short[lang]}
    crumbs={[{ label: tr('nav.sectors'), href: path(lang, 'sectors') }, { label: sector.title[lang] }]}
    image={images[related[0]?.image ?? 'hero']}
    focus="50% 65%"
  >
    <div class="row mt-3">
      <a href="#quote" class="btn btn--gold"><Icon name="send" />{tr('cta.quote')}</a>
    </div>
  </PageHero>

  <section class="section sec-detail">
    <div class="container sec-detail__inner">
      <div>
        <p class="lead reveal">{sector.intro[lang]}</p>
        <h2 class="h3 mt-5 reveal">{tr('sector.needs')}</h2>
        <ul class="check-list mt-2 reveal" data-delay="1">
          {sector.needs[lang].map((n) => <li>{n}</li>)}
        </ul>

        <h2 class="h3 mt-5 reveal">{tr('sector.services')}</h2>
        <div class="grid grid-2 mt-2">
          {related.map((s, i) => (
            <a href={path(lang, `services/${s!.slug}`)} class="sec-detail__svc reveal" data-delay={String(i + 1)}>
              <Image src={images[s!.image]} alt={s!.title[lang]} width={600} height={400} format="webp" quality={65} loading="lazy" />
              <div>
                <span class="badge">{s!.spec[lang]}</span>
                <h3 class="h3">{s!.title[lang]}</h3>
                <span class="link-arrow">{tr('cta.details')}<Icon name="arrow" /></span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <aside class="sec-detail__aside" id="quote">
        <div class="sec-detail__quote reveal" data-delay="2">
          <span class="card__icon"><Icon name={sector.icon} /></span>
          <h2 class="h3">{tr('service.quoteTitle')}</h2>
          <p class="mt-1">{tr('quote.subtitle')}</p>
          <div class="mt-3">
            <QuoteForm lang={lang} compact preset={related[0]?.slug} source={sector.title[lang]} />
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{tr('sector.other')}</span>
        <h2 class="h2">{tr('sectors.title')}</h2>
      </div>
    </div>
    <SectorsGrid lang={lang} heading={false} exclude={sector.slug} />
  </section>

  <CtaBand lang={lang} />
</Base>

<style>
  .sec-detail__inner {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }
  .sec-detail__svc {
    display: grid;
    grid-template-rows: auto 1fr;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .sec-detail__svc:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }
  .sec-detail__svc img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .sec-detail__svc > div {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
  }
  .sec-detail__svc h3 {
    font-size: 1.05rem;
  }
  .sec-detail__aside {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .sec-detail__quote {
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 26px;
  }
  .sec-detail__quote p {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .section--cream :global(.sectors) {
    padding-top: 0;
  }
  @media (max-width: 1024px) {
    .sec-detail__inner {
      grid-template-columns: 1fr;
    }
    .sec-detail__aside {
      position: static;
    }
  }
</style>
