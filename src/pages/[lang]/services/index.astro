---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import ServicesGrid from '../../../components/ServicesGrid.astro';
import TrustBar from '../../../components/TrustBar.astro';
import Process from '../../../components/Process.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { t } from '../../../i18n/ui';
import { staticLangPaths, type Lang } from '../../../i18n/utils';
import { images } from '../../../data/images';

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;
const tr = t(lang);
---

<Base lang={lang} title={tr('meta.services')} description={tr('services.text')} slug="services">
  <PageHero lang={lang} eyebrow={tr('services.eyebrow')} title={tr('services.title')} text={tr('services.text')} crumbs={[{ label: tr('nav.services') }]} image={images.sitrak} focus="50% 60%" />
  <TrustBar lang={lang} />
  <ServicesGrid lang={lang} heading={false} />
  <Process lang={lang} />
  <CtaBand lang={lang} />
</Base>
