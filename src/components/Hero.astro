---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import QuoteForm from './QuoteForm.astro';
import { t } from '../i18n/ui';
import { path, type Lang } from '../i18n/utils';
import { images } from '../data/images';
import { stats } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const heroStats = stats.slice(0, 4);
---

<section class="hero">
  <div class="hero__media">
    <Image src={images.hero} alt="" width={2000} densities={[1, 1.5]} format="webp" quality={74} loading="eager" fetchpriority="high" />
    <div class="hero__shade"></div>
    <div class="hero__grid"></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="hero__eyebrow reveal">{tr('hero.eyebrow')}</span>
      <h1 class="hero__title reveal" data-delay="1">
        <span>{tr('hero.title.1')}</span>
        <span class="hero__accent">{tr('hero.title.2')}</span>
      </h1>
      <p class="hero__text reveal" data-delay="2">{tr('hero.text')}</p>
      <div class="hero__actions reveal" data-delay="3">
        <a href="#quote" class="btn btn--gold btn--lg"><Icon name="send" />{tr('cta.quote')}</a>
        <a href={path(lang, 'contact') + '#inquiry'} class="btn btn--glass btn--lg"><Icon name="search" />{tr('cta.inquiry')}</a>
      </div>
      <ul class="hero__stats reveal" data-delay="4">
        {heroStats.map((s) => (
          <li>
            <strong class="num" data-count={s.value} data-suffix={s.suffix}>0{s.suffix}</strong>
            <span>{s.label[lang]}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="hero__quote reveal" data-delay="2" id="quote">
      <div class="hero__quote-head">
        <h2 class="h3">{tr('quote.title')}</h2>
        <span class="hero__quote-sub"><Icon name="clock" />{tr('quote.subtitle')}</span>
      </div>
      <QuoteForm lang={lang} compact source={lang === 'ar' ? 'من الصفحة الرئيسية' : 'From the home page'} />
    </div>
  </div>

  <a href="#services" class="hero__scroll" aria-label={tr('cta.explore')}>
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 960px);
    display: flex;
    align-items: center;
    padding-top: calc(var(--header-h) + 40px);
    padding-bottom: 72px;
    color: #fff;
    overflow: hidden;
    background: var(--navy-ink);
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 55%;
    transform: scale(1.06);
    animation: hero-zoom 16s ease-out forwards;
  }
  @keyframes hero-zoom {
    to {
      transform: scale(1);
    }
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(13, 19, 48, 0.96) 0%, rgba(13, 19, 48, 0.35) 40%, rgba(13, 19, 48, 0.15) 100%),
      linear-gradient(to left, rgba(13, 19, 48, 0.1) 0%, rgba(13, 19, 48, 0.75) 60%, rgba(13, 19, 48, 0.9) 100%);
  }
  html[dir='ltr'] .hero__shade {
    background:
      linear-gradient(to top, rgba(13, 19, 48, 0.96) 0%, rgba(13, 19, 48, 0.35) 40%, rgba(13, 19, 48, 0.15) 100%),
      linear-gradient(to right, rgba(13, 19, 48, 0.1) 0%, rgba(13, 19, 48, 0.75) 60%, rgba(13, 19, 48, 0.9) 100%);
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(70% 70% at 50% 50%, #000 20%, transparent 100%);
    -webkit-mask-image: radial-gradient(70% 70% at 50% 50%, #000 20%, transparent 100%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(360px, 0.9fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px 8px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: var(--gold-light);
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 26px;
    backdrop-filter: blur(8px);
  }
  .hero__eyebrow::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 4px rgba(201, 150, 47, 0.3);
  }
  .hero__title {
    display: flex;
    flex-direction: column;
    color: #fff;
    font-size: clamp(2.4rem, 5.4vw, 4.6rem);
    line-height: 1.12;
    text-shadow: 0 6px 40px rgba(0, 0, 0, 0.4);
  }
  html[lang='ar'] .hero__title {
    line-height: 1.25;
  }
  .hero__accent {
    color: var(--gold-light);
  }
  .hero__text {
    margin-top: 22px;
    max-width: 560px;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    color: rgba(255, 255, 255, 0.86);
  }
  .hero__actions {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }
  .hero__stats {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(4, max-content);
    justify-content: space-between;
    gap: 14px 24px;
    padding-top: 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .hero__stats li {
    display: flex;
    flex-direction: column;
  }
  .hero__stats strong {
    font-size: clamp(1.7rem, 2.6vw, 2.3rem);
    font-weight: 700;
    color: var(--gold-light);
    line-height: 1.1;
  }
  .hero__stats span {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.72);
  }
  .hero__quote {
    background: rgba(255, 255, 255, 0.96);
    color: var(--ink);
    border-radius: 28px;
    padding: 28px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .hero__quote-head {
    margin-bottom: 18px;
  }
  .hero__quote-sub {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.88rem;
    font-weight: 600;
  }
  .hero__quote-sub :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--gold);
  }
  .hero__scroll {
    position: absolute;
    bottom: 22px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    width: 26px;
    height: 42px;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-radius: 14px;
    display: flex;
    justify-content: center;
  }
  .hero__scroll span {
    width: 4px;
    height: 8px;
    margin-top: 6px;
    border-radius: 2px;
    background: var(--gold-light);
    animation: scroll-hint 1.8s ease-in-out infinite;
  }
  @keyframes scroll-hint {
    0%,
    100% {
      transform: translateY(0);
      opacity: 1;
    }
    60% {
      transform: translateY(14px);
      opacity: 0.2;
    }
  }
  @media (max-width: 1024px) {
    .hero {
      min-height: 0;
    }
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__scroll {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .hero__actions .btn {
      width: 100%;
    }
    .hero__quote {
      padding: 22px 16px;
    }
    .hero__stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }
    .hero__stats li {
      min-width: 0;
    }
  }
</style>
