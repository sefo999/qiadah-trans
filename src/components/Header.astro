---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { t } from '../i18n/ui';
import { other, path, type Lang } from '../i18n/utils';
import { site, waLink } from '../data/site';

interface Props {
  lang: Lang;
  slug?: string;
  transparent?: boolean;
}
const { lang, slug = '', transparent = false } = Astro.props;
const tr = t(lang);
const nav = [
  { href: path(lang), label: tr('nav.home'), key: '' },
  { href: path(lang, 'services'), label: tr('nav.services'), key: 'services' },
  { href: path(lang, 'sectors'), label: tr('nav.sectors'), key: 'sectors' },
  { href: path(lang, 'fleet'), label: tr('nav.fleet'), key: 'fleet' },
  { href: path(lang, 'about'), label: tr('nav.about'), key: 'about' },
  { href: path(lang, 'contact'), label: tr('nav.contact'), key: 'contact' },
];
const drawerNav = [...nav, { href: path(lang, 'careers'), label: tr('nav.careers'), key: 'careers' }];
const isActive = (key: string) => (key === '' ? slug === '' : slug === key || slug.startsWith(key + '/'));
const altHref = path(other(lang), slug);
const waQuote = waLink(lang === 'ar' ? 'السلام عليكم، أرغب في طلب عرض سعر لنقل شحنة.' : 'Hello, I would like to request a quote for a shipment.');
---

<header class:list={['header', { 'header--transparent': transparent }]} id="header">
  <div class="container header__inner">
    <a href={path(lang)} class="header__logo" aria-label={site.name[lang]}>
      <Logo lang={lang} variant="light" size={48} />
    </a>

    <nav class="header__nav" aria-label={tr('nav.menu')}>
      <ul>
        {nav.map((n) => (
          <li>
            <a href={n.href} class:list={{ 'is-active': isActive(n.key) }} aria-current={isActive(n.key) ? 'page' : undefined}>
              {n.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <a href={altHref} class="header__lang" hreflang={other(lang)} lang={other(lang)} title={tr('lang.switch')}>
        <Icon name="globe" />
        <span>{tr('lang.switchShort')}</span>
      </a>
      <a href={path(lang, 'contact') + '#inquiry'} class="header__inq" title={tr('cta.inquiry')}>
        <Icon name="search" />
        <span>{tr('cta.inquiry')}</span>
      </a>
      <a href={path(lang, 'contact') + '#quote'} class="btn btn--gold btn--sm header__quote">
        <Icon name="send" />
        {tr('cta.quote')}
      </a>
      <button class="header__burger" type="button" aria-expanded="false" aria-controls="drawer" aria-label={tr('nav.menu')} data-menu-toggle>
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="drawer" hidden>
  <div class="drawer__head">
    <Logo lang={lang} variant="dark" size={40} />
    <button class="drawer__close" type="button" aria-label={tr('nav.close')} data-menu-toggle>
      <Icon name="close" />
    </button>
  </div>
  <ul class="drawer__nav">
    {drawerNav.map((n) => (
      <li>
        <a href={n.href} class:list={{ 'is-active': isActive(n.key) }}>{n.label}</a>
      </li>
    ))}
    <li>
      <a href={altHref} hreflang={other(lang)} lang={other(lang)} class="drawer__lang">
        <Icon name="globe" />
        {tr('lang.switch')}
      </a>
    </li>
  </ul>
  <div class="drawer__cta">
    <a href={path(lang, 'contact') + '#quote'} class="btn btn--gold btn--block"><Icon name="send" />{tr('cta.quote')}</a>
    <a href={waQuote} class="btn btn--wa btn--block" target="_blank" rel="noopener"><Icon name="whatsapp" />{tr('cta.whatsapp')}</a>
    <a href={site.phone.tel} class="btn btn--outline btn--block"><Icon name="phone" /><span class="num">{site.phone.display}</span></a>
  </div>
</div>

<style>
  .header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 100;
    height: var(--header-h);
    background: rgba(20, 29, 66, 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: #fff;
    border-bottom: 1px solid var(--line-dark);
    transition: background 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .header--transparent:not(.is-scrolled) {
    background: linear-gradient(to bottom, rgba(13, 19, 48, 0.75), rgba(13, 19, 48, 0));
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
  }
  .header.is-scrolled {
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
  }
  .header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .header__logo {
    flex: none;
    display: inline-flex;
  }
  .header__nav {
    flex: 1;
    display: flex;
    justify-content: center;
    min-width: 0;
  }
  .header__nav ul {
    display: flex;
    gap: 2px;
  }
  .header__nav a {
    display: block;
    padding: 10px 13px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.82);
    transition: background 0.2s ease, color 0.2s ease;
  }
  .header__nav a:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }
  .header__nav a.is-active {
    color: var(--gold-light);
    position: relative;
  }
  .header__nav a.is-active::after {
    content: '';
    position: absolute;
    inset-inline: 13px;
    bottom: 4px;
    height: 2px;
    border-radius: 2px;
    background: var(--gold);
  }
  .header__actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
  }
  .header__lang,
  .header__inq {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding: 0 12px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.88rem;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.22);
    transition: background 0.2s ease;
  }
  .header__lang:hover,
  .header__inq:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  .header__lang :global(svg),
  .header__inq :global(svg) {
    width: 18px;
    height: 18px;
  }
  .header__quote {
    height: 40px;
  }
  .header__burger,
  .drawer__close {
    display: none;
    background: none;
    border: 0;
    padding: 8px;
    cursor: pointer;
    color: inherit;
  }
  .header__burger :global(svg),
  .drawer__close :global(svg) {
    width: 28px;
    height: 28px;
  }
  @media (max-width: 1340px) {
    .header__inq span {
      display: none;
    }
    .header__inq {
      width: 40px;
      padding: 0;
      justify-content: center;
    }
  }
  @media (max-width: 1180px) {
    .header__nav,
    .header__lang,
    .header__inq {
      display: none;
    }
    .header__burger,
    .drawer__close {
      display: inline-flex;
    }
    .header__inner {
      justify-content: space-between;
    }
  }
  @media (max-width: 480px) {
    .header__quote {
      display: none;
    }
  }

  /* drawer */
  .drawer {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: var(--paper);
    color: var(--ink);
    display: flex;
    flex-direction: column;
    padding: 16px var(--gutter) 32px;
    overflow-y: auto;
    animation: drawer-in 0.25s ease;
  }
  .drawer[hidden] {
    display: none;
  }
  @keyframes drawer-in {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 44px;
    margin-bottom: 24px;
  }
  .drawer__close {
    color: var(--navy);
  }
  .drawer__nav {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }
  .drawer__nav a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 4px;
    border-bottom: 1px solid var(--line);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--navy);
  }
  .drawer__nav a.is-active {
    color: var(--gold);
  }
  .drawer__lang :global(svg) {
    width: 20px;
    height: 20px;
  }
  .drawer__cta {
    margin-top: auto;
    padding-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
</style>
