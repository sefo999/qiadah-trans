---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t } from '../i18n/ui';
import { path, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  eyebrow?: string;
  title: string;
  text?: string;
  crumbs?: { label: string; href?: string }[];
  image?: ImageMetadata;
  /** vertical focus of the background photo, e.g. "50% 60%" */
  focus?: string;
}
const { lang, eyebrow, title, text, crumbs = [], image, focus = '50% 55%' } = Astro.props;
const tr = t(lang);
---

<section class:list={['phero', { 'phero--photo': !!image }]}>
  {image && (
    <div class="phero__media" style={`--focus:${focus}`}>
      <Image src={image} alt="" width={1800} format="webp" quality={68} loading="eager" fetchpriority="high" />
      <div class="phero__shade"></div>
      <div class="phero__grid"></div>
    </div>
  )}
  <div class="container phero__inner">
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href={path(lang)}>{tr('breadcrumb.home')}</a>
      {crumbs.map((c) => (
        <span>{c.href ? <a href={c.href}>{c.label}</a> : c.label}</span>
      ))}
    </nav>
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 class="phero__title">{title}</h1>
    {text && <p class="lead">{text}</p>}
    <slot />
  </div>
</section>

<style>
  .phero {
    position: relative;
    background: var(--navy);
    color: #fff;
    padding-top: calc(var(--header-h) + clamp(44px, 6vw, 80px));
    padding-bottom: clamp(44px, 6vw, 80px);
    overflow: hidden;
    isolation: isolate;
  }
  .phero--photo {
    min-height: 460px;
    display: flex;
    align-items: flex-end;
  }
  .phero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .phero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus);
  }
  .phero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(13, 19, 48, 0.96) 0%, rgba(13, 19, 48, 0.55) 55%, rgba(13, 19, 48, 0.35) 100%),
      linear-gradient(to left, rgba(13, 19, 48, 0) 0%, rgba(13, 19, 48, 0.6) 60%, rgba(13, 19, 48, 0.85) 100%);
  }
  html[dir='ltr'] .phero__shade {
    background:
      linear-gradient(to top, rgba(13, 19, 48, 0.96) 0%, rgba(13, 19, 48, 0.55) 55%, rgba(13, 19, 48, 0.35) 100%),
      linear-gradient(to right, rgba(13, 19, 48, 0) 0%, rgba(13, 19, 48, 0.6) 60%, rgba(13, 19, 48, 0.85) 100%);
  }
  .phero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(70% 80% at 50% 50%, #000 20%, transparent 100%);
    -webkit-mask-image: radial-gradient(70% 80% at 50% 50%, #000 20%, transparent 100%);
  }
  .phero:not(.phero--photo)::after {
    content: '';
    position: absolute;
    inset-inline-end: -10%;
    top: -30%;
    width: 60%;
    height: 160%;
    z-index: -1;
    background: radial-gradient(closest-side, rgba(201, 150, 47, 0.22), transparent 70%);
    pointer-events: none;
  }
  .phero__inner {
    position: relative;
  }
  .phero__title {
    color: #fff;
    font-size: clamp(2.1rem, 4.8vw, 3.8rem);
    max-width: 16ch;
    text-shadow: 0 6px 40px rgba(0, 0, 0, 0.4);
  }
  .phero .lead {
    color: rgba(255, 255, 255, 0.82);
    max-width: 700px;
  }
  .phero .eyebrow {
    color: var(--gold-light);
  }
</style>
