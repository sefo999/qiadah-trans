---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { t } from '../i18n/ui';
import { path, type Lang } from '../i18n/utils';
import { services } from '../data/services';
import { images } from '../data/images';

interface Props {
  lang: Lang;
  heading?: boolean;
  exclude?: string;
  limit?: number;
}
const { lang, heading = true, exclude, limit } = Astro.props;
const tr = t(lang);
let list = services.filter((s) => s.slug !== exclude);
if (limit) list = list.slice(0, limit);
---

<section class="section services" id="services">
  <div class="container">
    {heading && (
      <div class="section-head section-head--split reveal">
        <div>
          <span class="eyebrow">{tr('services.eyebrow')}</span>
          <h2 class="h2">{tr('services.title')}</h2>
        </div>
        <p class="lead">{tr('services.text')}</p>
      </div>
    )}
    <div class="services__grid">
      {list.map((s, i) => (
        <a href={path(lang, `services/${s.slug}`)} class="svc reveal" data-delay={String((i % 3) + 1)}>
          <Image src={images[s.image]} alt="" width={800} height={600} format="webp" quality={70} loading="lazy" class="svc__img" />
          <div class="svc__shade"></div>
          <div class="svc__top">
            <span class="svc__icon"><Icon name={s.icon} /></span>
            <span class="svc__spec">{s.spec[lang]}</span>
          </div>
          <div class="svc__body">
            <h3>{s.title[lang]}</h3>
            <p>{s.short[lang]}</p>
            <span class="svc__more">{tr('cta.details')}<Icon name="arrow" /></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .svc {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 420px;
    border-radius: 26px;
    overflow: hidden;
    background: var(--navy);
    color: #fff;
    isolation: isolate;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .svc:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }
  .svc :global(.svc__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 65%;
    z-index: -2;
    transition: transform 0.7s ease;
  }
  .svc:hover :global(.svc__img) {
    transform: scale(1.06);
  }
  .svc__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(13, 19, 48, 0.96) 0%, rgba(13, 19, 48, 0.72) 38%, rgba(13, 19, 48, 0.1) 75%, rgba(13, 19, 48, 0.25) 100%);
    transition: opacity 0.3s ease;
  }
  .svc__top {
    position: absolute;
    inset-inline: 18px;
    top: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .svc__icon {
    width: 50px;
    height: 50px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(8px);
    color: #fff;
  }
  .svc__icon :global(svg) {
    width: 26px;
    height: 26px;
  }
  .svc__spec {
    padding: 7px 12px;
    border-radius: 999px;
    background: var(--gold);
    color: var(--navy-ink);
    font-size: 0.8rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .svc__body {
    padding: 24px 22px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .svc__body h3 {
    color: #fff;
    font-size: 1.3rem;
  }
  .svc__body p {
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.95rem;
    line-height: 1.6;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, opacity 0.3s ease;
  }
  .svc:hover .svc__body p,
  .svc:focus-visible .svc__body p {
    max-height: 120px;
    opacity: 1;
  }
  .svc__more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--gold-light);
    font-weight: 700;
    font-size: 0.95rem;
    margin-top: 4px;
  }
  .svc__more :global(svg) {
    width: 18px;
    height: 18px;
  }
  html[dir='rtl'] .svc__more :global(svg) {
    transform: scaleX(-1);
  }
  @media (max-width: 1024px) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
    .svc {
      min-height: 320px;
    }
    .svc__body p {
      max-height: none;
      opacity: 1;
    }
  }
  @media (hover: none) {
    .svc__body p {
      max-height: none;
      opacity: 1;
    }
  }
</style>
