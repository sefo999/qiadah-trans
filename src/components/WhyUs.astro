---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { t } from '../i18n/ui';
import { path, type Lang } from '../i18n/utils';
import { whyUs } from '../data/site';
import { images } from '../data/images';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
---

<section class="section section--navy why contour contour--dark">
  <div class="container why__inner">
    <div class="why__media reveal">
      <Image src={images.hopperRow} alt="" width={960} height={1100} format="webp" quality={70} loading="lazy" />
      <div class="why__stamp">
        <strong class="num">30</strong>
        <span>{lang === 'ar' ? 'عاماً من الخبرة' : 'years of experience'}</span>
      </div>
    </div>
    <div class="why__copy">
      <div class="section-head reveal">
        <span class="eyebrow">{tr('why.eyebrow')}</span>
        <h2 class="h2">{tr('why.title')}</h2>
        <p class="lead">{tr('why.text')}</p>
      </div>
      <ul class="why__list">
        {whyUs.map((w, i) => (
          <li class="reveal" data-delay={String((i % 2) + 1)}>
            <span class="why__icon"><Icon name={w.icon} /></span>
            <div>
              <h3>{w.title[lang]}</h3>
              <p>{w.text[lang]}</p>
            </div>
          </li>
        ))}
      </ul>
      <a href={path(lang, 'about')} class="btn btn--gold mt-4 reveal">{tr('cta.more')}<Icon name="arrow" class="icon-arrow" /></a>
    </div>
  </div>
</section>

<style>
  .why__inner {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .why__media {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    box-shadow: var(--shadow-lg);
  }
  .why__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .why__stamp {
    position: absolute;
    inset-inline-start: 20px;
    bottom: 20px;
    background: var(--gold);
    color: var(--navy-ink);
    padding: 16px 22px;
    border-radius: 18px;
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .why__stamp strong {
    font-size: 2.4rem;
    font-weight: 700;
  }
  .why__stamp span {
    font-weight: 700;
    font-size: 0.9rem;
  }
  .why__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px 28px;
  }
  .why__list li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .why__icon {
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--gold-light);
  }
  .why__icon :global(svg) {
    width: 24px;
    height: 24px;
  }
  .why__list h3 {
    font-size: 1.08rem;
    margin-bottom: 4px;
  }
  .why__list p {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.75);
  }
  @media (max-width: 1024px) {
    .why__inner {
      grid-template-columns: 1fr;
    }
    .why__media {
      aspect-ratio: 16 / 10;
      max-height: 420px;
    }
  }
  @media (max-width: 640px) {
    .why__list {
      grid-template-columns: 1fr;
    }
  }
</style>
